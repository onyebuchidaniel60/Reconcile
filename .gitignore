# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (example values live in .env.example)
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Vercel CLI link metadata (project/org ids, no secrets)
.vercel
# Local secret env files. NOTE: .env.production holds only public
# EXPO_PUBLIC_* values and IS committed; do not broaden this block.
.env.local
.env*.local
