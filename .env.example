# Copy to `.env` for local development. Never commit real secrets.
#
# Only EXPO_PUBLIC_* keys are exposed to the mobile client.
# Server-only secrets (Supabase service-role key, Mono secret/webhook secret,
# OpenAI API key, RevenueCat webhook secret) must NEVER use the EXPO_PUBLIC_
# prefix and must never live in this app. They are introduced in later phases
# as server-side (Supabase Edge Function) environment variables only.

EXPO_PUBLIC_APP_ENV=development

# Introduced with later phases (Supabase Auth, RevenueCat):
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
