# Copy to `.env` for local development. Never commit real secrets.
#
# Only EXPO_PUBLIC_* keys are exposed to the mobile client.
# Phase 1 needs only EXPO_PUBLIC_APP_ENV. Later phases add their own
# client-safe keys; server-only secrets must never live in this app.

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
